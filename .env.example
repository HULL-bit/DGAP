# Copier en .env à la racine du monorepo. Aucune valeur réelle ici (§15).

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,backend
# Signature des QR (permis de visite, convocations) — vide en dev = repli sur DJANGO_SECRET_KEY.
QR_SIGNING_KEY=
# Chiffrement applicatif AES-256-GCM de l'identité des personnes détenues
# (apps.detenus, §9.3) — 32 octets encodés en base64. La valeur par défaut du code
# (config/settings/base.py) n'est PAS sécurisée : à remplacer impérativement par un
# secret propre à chaque environnement réel (ex. `openssl rand -base64 32`).
CLE_CHIFFREMENT_DONNEES=

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=dgap
POSTGRES_USER=dgap
POSTGRES_PASSWORD=change-moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery --------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- MinIO (stockage objet S3) ----------------------------------------------------
MINIO_ROOT_USER=dgap
MINIO_ROOT_PASSWORD=change-moi-au-moins-8-caracteres
MINIO_ACCESS_KEY=dgap
MINIO_SECRET_KEY=change-moi-au-moins-8-caracteres
MINIO_BUCKET=dgap-medias
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_REGION=us-east-1

# --- E-mail (Mailhog en dev) -------------------------------------------------------
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- CORS (aucun joker en prod, §9.3) ----------------------------------------------
CORS_ALLOWED_ORIGINS=https://www.localhost,https://demarches.localhost,https://intranet.localhost,https://admin.localhost

# --- Frontend (par app, injecté au build Vite) --------------------------------------
VITE_API_BASE_URL=/api/v1
# Base des liens du portail vers les démarches — jamais codée en dur (voir src/config.ts).
VITE_DEMARCHES_URL=https://demarches.localhost
# Base des liens de l'intranet vers le back-office (raccourcis métier du tableau de bord).
VITE_BACKOFFICE_URL=https://admin.localhost

# --- Journalisation --------------------------------------------------------------
LOG_LEVEL=INFO
# Supervision des erreurs (config.settings.prod uniquement) — vide = désactivé,
# aucun envoi vers un tiers tant que ce DSN n'est pas renseigné.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Profils optionnels (docker-compose --profile) ------------------------------
# full  : ajoute elasticsearch, keycloak
# prod-like : build de production, sans mailhog/minio en clair
